services:
  server:
    build: ./Backend/
    container_name: chat-server
    env_file: ./Backend/.env
    expose:
      - "5000"          # only reachable by other containers, not the internet
    networks:
      - chat-net
    restart: unless-stopped

  client:
    build: ./Frontend/
    container_name: chat-client
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./certbot/conf:/etc/letsencrypt:ro
      - ./certbot/www:/var/www/certbot:ro
    # reload nginx every 6h so it picks up renewed certs
    command: >
      /bin/sh -c "while :; do sleep 6h & wait $${!}; nginx -s reload; done &
      nginx -g 'daemon off;'"
    depends_on:
      - server
    networks:
      - chat-net
    restart: unless-stopped

  certbot:
    image: certbot/certbot
    container_name: chat-certbot
    volumes:
      - ./certbot/conf:/etc/letsencrypt
      - ./certbot/www:/var/www/certbot
    entrypoint: >
      /bin/sh -c "trap exit TERM; while :; do
      certbot renew --webroot -w /var/www/certbot;
      sleep 12h & wait $${!}; done"
    networks:
      - chat-net
    restart: unless-stopped

networks:
  chat-net:
    driver: bridge